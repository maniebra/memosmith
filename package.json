{
  "name": "memosmith",
  "private": true,
  "version": "0.1.2",
  "type": "module",
  "scripts": {
    "dev": "npm run fonts && vite",
    "check": "svelte-check --tsconfig ./tsconfig.json",
    "lint": "eslint \"src/**/*.{ts,svelte}\" \"tests/**/*.ts\"",
    "build": "npm run fonts && svelte-check --tsconfig ./tsconfig.json && vite build",
    "preview": "vite preview",
    "tauri": "tauri",
    "fonts": "node -e \"fs.cpSync('node_modules/@excalidraw/excalidraw/dist/prod/fonts','public/fonts',{recursive:true,filter:p=>!p.includes('Xiaolai')})\""
  },
  "dependencies": {
    "@excalidraw/excalidraw": "^0.18.1",
    "@lucide/svelte": "^1.28.0",
    "@tauri-apps/api": "^2",
    "@tauri-apps/plugin-dialog": "^2",
    "@tauri-apps/plugin-http": "^2.5.9",
    "clsx": "^2.1.1",
    "highlight.js": "^11.11.1",
    "katex": "^0.18.1",
    "mermaid": "^11.16.1",
    "react": "^19.2.8",
    "react-dom": "^19.2.8",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@eslint/js": "^10.0.1",
    "@sveltejs/vite-plugin-svelte": "^7.2.0",
    "@tailwindcss/vite": "^4.3.3",
    "@tauri-apps/cli": "^2",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "eslint": "^10.8.1",
    "eslint-plugin-svelte": "^3.22.0",
    "globals": "^17.9.0",
    "svelte": "^5.56.8",
    "svelte-check": "^4.7.4",
    "tailwindcss": "^4.3.3",
    "typescript": "~5.6.2",
    "typescript-eslint": "^8.66.0",
    "vite": "^8.2.0"
  }
}